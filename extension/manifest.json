{
  "manifest_version": 3,
  "name": "Liga Fitboxers",
  "version": "0.4.0",
  "description": "Captura las clases de la app del club, calcula los puntos de la liga y publica la clasificación.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://myh4c.brooklynfitzone.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://myh4c.brooklynfitzone.com/*"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://myh4c.brooklynfitzone.com/*"],
      "js": ["content/relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "ui/popup.html", "default_title": "Liga Fitboxers" },
  "options_page": "ui/options.html"
}
